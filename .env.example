# Copy this file to .env and fill in what you have. Everything is optional:
# without keys the demo uses a template script and the browser coordinator phone.

# Claude writes the spoken alert and understands free-form replies
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Twilio places a real phone call to the coordinator
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15555550100
# On a trial account this number must be verified in the Twilio console
COORDINATOR_PHONE=+15555550123
# Your public https URL (from `ngrok http 8000`), no trailing slash
PUBLIC_URL=

# Protects every page and API except /voice/* (Twilio is verified by signature instead).
# Set both whenever the app is reachable over ngrok.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Optional
# DECISION_LOG=decision_log.jsonl
# BOX_OFFLINE_SEC=600
# FEEDS_APPLY=0
